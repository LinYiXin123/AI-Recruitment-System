DJANGO_DEBUG=1
# 免凭据体验入口默认关闭；仅限本机虚构数据演示时显式设为 1，局域网访问必须保持 0。
LOCAL_EXPERIENCE_ENABLED=0
# 复制到 .env 后，用独立随机值替换；不要提交 .env。
DJANGO_SECRET_KEY=replace-with-a-long-random-value
PGDATABASE=recruitment
PGUSER=recruitment
PGPASSWORD=replace-with-a-local-database-password
PGHOST=127.0.0.1
PGPORT=55432
LOCAL_ACCOUNT_PASSWORD=replace-with-a-local-account-password

# 飞书网页登录仅由 Django 服务端使用，绝不能写进前端环境变量或提交到 Git。
FEISHU_APP_ID=replace-with-your-feishu-app-id
FEISHU_APP_SECRET=replace-with-your-feishu-app-secret
# 此地址必须与飞书开放平台中登记的重定向地址逐字一致。
FEISHU_REDIRECT_URI=http://localhost:5173/api/v1/auth/login/
# 飞书验证成功后进入本机 HR 工作台。
FEISHU_LOGIN_SUCCESS_URL=http://localhost:5174/#today
# 未登录访问工作台、退出登录后返回的公共首页；部署时改为正式首页地址。
PUBLIC_HOME_URL=http://localhost:5173/
# 仅本机首次联调可指定一个已有 HR 体验账号；首次绑定成功后，其他飞书账号不会自动开通。
FEISHU_LOCAL_BOOTSTRAP_HR_USERNAME=

# 模型服务仅在后端使用；复制为 .env 后填入实际值，绝不能提交或写进前端环境变量。
LLM_API_BASE_URL=https://your-model-provider.example/v1
LLM_API_KEY=replace-with-your-model-api-key
LLM_MODEL=replace-with-your-model-name
